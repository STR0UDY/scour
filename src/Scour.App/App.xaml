<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Scour.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FF0D9488</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF14B8A6</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF2DD4BF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF5EEAD4</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF0F766E</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF115E59</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF134E4A</Color>
                    <SolidColorBrush x:Key="ScourCautionBrush" Color="#FFB45309" />
                    <SolidColorBrush x:Key="ScourCautionBackgroundBrush" Color="#1FF59E0B" />
                    <SolidColorBrush x:Key="ScourAdvancedBrush" Color="#FFB91C1C" />
                    <SolidColorBrush x:Key="ScourAdvancedBackgroundBrush" Color="#1FEF4444" />
                    <SolidColorBrush x:Key="ScourGoodBrush" Color="#FF15803D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#FF2DD4BF</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF5EEAD4</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF99F6E4</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFCCFBF1</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF14B8A6</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF0D9488</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF0F766E</Color>
                    <SolidColorBrush x:Key="ScourCautionBrush" Color="#FFFBBF24" />
                    <SolidColorBrush x:Key="ScourCautionBackgroundBrush" Color="#26F59E0B" />
                    <SolidColorBrush x:Key="ScourAdvancedBrush" Color="#FFF87171" />
                    <SolidColorBrush x:Key="ScourAdvancedBackgroundBrush" Color="#26EF4444" />
                    <SolidColorBrush x:Key="ScourGoodBrush" Color="#FF4ADE80" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="ScourIcons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

            <!-- Page header. -->
            <Style x:Key="ScourPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="ScourSubtle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ScourCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A raised card. -->
            <Style x:Key="ScourCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Small pill used for safety and status badges. -->
            <Style x:Key="ScourBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
