<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Scour.App.Views.AnalysePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Scour.App.ViewModels"
    xmlns:h="using:Scour.App.Helpers"
    xmlns:c="using:Scour.App.Controls">

    <Grid Padding="36,8,36,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Analyse" Style="{StaticResource ScourPageTitle}" />
            <TextBlock Style="{StaticResource ScourSubtle}" Text="See where the space on a drive went. Click a block to drill in; right-click for actions." />
        </StackPanel>

        <!-- What to analyse. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DrivePicker" ItemsSource="{x:Bind Vm.Drives}" SelectedItem="{x:Bind Vm.SelectedDrive, Mode=TwoWay}" MinWidth="260"
                      AutomationProperties.Name="Drive" SelectionChanged="OnDriveChanged" />
            <Button Grid.Column="1" Content="Choose folder…" Click="OnChooseFolderClick" />
            <CheckBox Grid.Column="2" Content="Fast scan" Margin="12,0,0,0" AutomationProperties.Name="Fast scan"
                      ToolTipService.ToolTip="Reads the drive's master file table directly: seconds instead of minutes. Asks for admin once."
                      IsChecked="{x:Bind Vm.UseFastScan, Mode=TwoWay}" Visibility="{x:Bind h:Format.Show(Vm.CanUseFastScan), Mode=OneWay}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Stop" Click="OnStopClick" Visibility="{x:Bind h:Format.Show(Vm.IsBusy), Mode=OneWay}" />
                <Button Style="{StaticResource AccentButtonStyle}" Click="OnAnalyseClick" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                        AutomationProperties.Name="Analyse">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB05;" FontSize="14" />
                        <TextBlock Text="Analyse" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="{x:Bind CustomFolderText(Vm.CustomFolder), Mode=OneWay}" Style="{StaticResource ScourCaption}"
                       Visibility="{x:Bind h:Format.ShowText(Vm.CustomFolder), Mode=OneWay}" />
            <ProgressBar Value="{x:Bind ProgressValue(Vm.ProgressFraction), Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate(Vm.ProgressFraction), Mode=OneWay}"
                         Visibility="{x:Bind h:Format.Show(Vm.IsBusy), Mode=OneWay}" />
            <TextBlock Text="{x:Bind Vm.Progress, Mode=OneWay}" Style="{StaticResource ScourCaption}" Visibility="{x:Bind h:Format.Show(Vm.IsBusy), Mode=OneWay}" />
            <Grid Visibility="{x:Bind h:Format.Show(Vm.HasTree), Mode=OneWay}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Click="OnUpClick" Padding="6" ToolTipService.ToolTip="Up one level" AutomationProperties.Name="Up">
                    <FontIcon Glyph="&#xE74A;" FontSize="12" />
                </Button>
                <!-- No typed template: the bar adds a null item for its overflow ellipsis. Crumb.ToString() gives the text. -->
                <BreadcrumbBar Grid.Column="1" ItemsSource="{x:Bind Vm.Breadcrumb}" ItemClicked="OnCrumbClicked" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource ScourCaption}" Visibility="{x:Bind h:Format.Show(Vm.HasTree), Mode=OneWay}" />
        </StackPanel>

        <!-- Before the first analysis. -->
        <Border Grid.Row="3" Style="{StaticResource ScourCard}" VerticalAlignment="Top" Visibility="{x:Bind h:Format.Show(Vm.ShowEmpty), Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Text="Pick a drive and choose Analyse" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Style="{StaticResource ScourSubtle}"
                           Text="With fast scan, Scour reads the drive's master file table directly, the way WizTree does: a whole drive takes seconds. Without admin it walks folders instead, which is slower and skips folders it can't open. Analysing never changes anything." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16" Visibility="{x:Bind h:Format.Show(Vm.HasTree), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <c:TreemapView x:Name="Map" NodeInvoked="OnMapNodeInvoked" NodeContextRequested="OnMapContext" />
            </Border>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="ViewPicker" SelectionChanged="OnViewChanged">
                    <SelectorBarItem Text="Folders" IsSelected="True" />
                    <SelectorBarItem Text="File types" />
                </SelectorBar>

                <!-- Tree list. -->
                <Grid x:Name="TreePanel" Grid.Row="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Padding="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Content="Name" Tag="Name" Click="OnSortClick" Padding="0" />
                        <HyperlinkButton Grid.Column="1" Content="Size" Tag="Size" Click="OnSortClick" Padding="0" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource ScourCaption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="3" Content="Files" Tag="Files" Click="OnSortClick" Padding="0" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Rows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TreeRow">
                                    <Grid ColumnSpacing="8" Padding="8,3" Background="Transparent"
                                          DoubleTapped="OnRowDoubleTapped" RightTapped="OnRowRightTapped" Tag="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="{x:Bind IndentMargin}">
                                            <Button Padding="2" Width="22" Height="22" Background="Transparent" BorderThickness="0" Click="OnChevronClick" Tag="{Binding}"
                                                    Visibility="{x:Bind h:Format.Show(HasChildren)}" AutomationProperties.Name="Expand">
                                                <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="10" />
                                            </Button>
                                            <Border Width="22" Visibility="{x:Bind h:Format.Hide(HasChildren)}" />
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ScourCaption}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind FilesText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ScourCaption}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>

                <!-- File type breakdown. -->
                <ScrollViewer x:Name="TypesPanel" Grid.Row="1" Visibility="Collapsed">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Types}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeRow">
                                <Grid ColumnSpacing="12" Padding="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Extension}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{x:Bind Share}" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind CountText}" HorizontalAlignment="Right" Style="{StaticResource ScourCaption}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
