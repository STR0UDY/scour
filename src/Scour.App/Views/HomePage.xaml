<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Scour.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Scour.App.ViewModels"
    xmlns:h="using:Scour.App.Helpers"
    xmlns:local="using:Scour.App.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="36,8,36,36" Spacing="16">
            <TextBlock Text="Home" Style="{StaticResource ScourPageTitle}" />

            <!-- The one thing most people need: scan, see the number, clean. -->
            <Border Style="{StaticResource ScourCard}" Padding="32">
                <Grid>
                    <!-- Before the first scan. -->
                    <StackPanel Spacing="16" Visibility="{x:Bind h:Format.Show(Vm.ShowScanPrompt), Mode=OneWay}">
                        <TextBlock Text="Find junk you can safely remove" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource ScourSubtle}" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Scour looks through temp files, caches and logs, then shows you exactly what it found. Nothing is deleted until you choose to clean." />
                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnScanClick" Padding="36,12" FontSize="18" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE721;" FontSize="18" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Scanning. -->
                    <StackPanel Spacing="16" Orientation="Horizontal" Visibility="{x:Bind h:Format.Show(Vm.IsScanning), Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind Vm.IsScanning, Mode=OneWay}" Width="40" Height="40" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Scanning…" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.ScanStatus, Mode=OneWay}" Style="{StaticResource ScourSubtle}" />
                        </StackPanel>
                        <Button Content="Stop" Click="OnStopClick" VerticalAlignment="Center" Margin="24,0,0,0" />
                    </StackPanel>

                    <!-- Results. -->
                    <Grid ColumnSpacing="40" Visibility="{x:Bind h:Format.Show(Vm.ShowResults), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" MinWidth="220">
                            <TextBlock Text="{x:Bind Vm.ReclaimableText, Mode=OneWay}" FontSize="48" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="reclaimable" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.ReclaimableDetail, Mode=OneWay}" Style="{StaticResource ScourCaption}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="OnCleanClick" Padding="28,8"
                                        IsEnabled="{x:Bind Vm.CanClean, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        <TextBlock Text="Clean" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Review" Click="OnReviewClick" />
                                <Button Click="OnScanClick" ToolTipService.ToolTip="Scan again">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{x:Bind h:Format.Show(Vm.IsCleaning), Mode=OneWay}" />
                        </StackPanel>

                        <!-- Per-category breakdown of what's ticked. -->
                        <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Vm.Groups}" VerticalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryGroup">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="2" Value="{x:Bind Share, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </Grid>
            </Border>

            <InfoBar IsOpen="{x:Bind Vm.HasResult, Mode=OneWay}" Severity="Success" IsClosable="True" CloseButtonClick="OnResultClosed"
                     Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultDetail, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Open the log" Click="OnOpenLogClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar IsOpen="{x:Bind HasAdminWaiting(Vm.AdminRulesWaiting), Mode=OneWay}" Severity="Informational" IsClosable="False"
                     Title="Some system items need admin access"
                     Message="Windows temp files, update caches and system logs can only be scanned with admin rights. Scour asks once, then a small helper does just that.">
                <InfoBar.ActionButton>
                    <Button Content="Allow" Click="OnUnlockClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ScourCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Last clean" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LastCleanText" Style="{StaticResource ScourSubtle}" />
                        <HyperlinkButton x:Name="LastLogLink" Content="Open the log" Padding="0" Click="OnLastLogClick" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ScourCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Drives" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsRepeater x:Name="DriveList">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:DriveRow">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Label}" />
                                            <TextBlock Text="{x:Bind FreeText}" HorizontalAlignment="Right" Style="{StaticResource ScourCaption}" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
