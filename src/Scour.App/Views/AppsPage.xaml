<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Scour.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Scour.App.ViewModels"
    xmlns:h="using:Scour.App.Helpers">

    <Grid Padding="36,8,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Apps" Style="{StaticResource ScourPageTitle}" />
            <TextBlock Style="{StaticResource ScourSubtle}"
                       Text="Uninstall runs the app's own uninstaller. Then Scour looks for leftovers and shows them to you, unticked." />
            <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource ScourCaption}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search apps or publishers" QueryIcon="Find" MaxWidth="420" HorizontalAlignment="Left" MinWidth="300"
                            Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" x:Name="SortPicker" SelectionChanged="OnSortChanged" MinWidth="160" SelectedIndex="0" AutomationProperties.Name="Sort">
                <ComboBoxItem Content="Sort by name" Tag="Name" />
                <ComboBoxItem Content="Sort by size" Tag="Size" />
                <ComboBoxItem Content="Sort by install date" Tag="Date" />
            </ComboBox>
        </Grid>

        <InfoBar Grid.Row="2" IsOpen="{x:Bind Vm.IsUninstalling, Mode=OneWay}" IsClosable="False" Severity="Informational"
                 Title="{x:Bind WaitingTitle(Vm.Uninstalling), Mode=OneWay}"
                 Message="Finish the steps in its window. Scour carries on once the app is gone.">
            <InfoBar.ActionButton>
                <Button Content="It's finished" Click="OnFinishedClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3">
            <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />
            <ScrollViewer Margin="-36,0" Padding="36,0">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Rows}" Margin="0,0,0,36">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppRow">
                            <Border Style="{StaticResource ScourCard}" Padding="16,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource ScourCaption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DateText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ScourCaption}" />
                                    <Button Grid.Column="4" Content="Uninstall" Click="OnUninstallClick" Tag="{Binding}" IsEnabled="{x:Bind CanUninstall}"
                                            AutomationProperties.Name="{x:Bind UninstallLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
