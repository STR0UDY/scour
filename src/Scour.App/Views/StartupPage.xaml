<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Scour.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Scour.App.ViewModels"
    xmlns:h="using:Scour.App.Helpers">

    <Grid Padding="36,8,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Startup" Style="{StaticResource ScourPageTitle}" />
            <TextBlock Style="{StaticResource ScourSubtle}"
                       Text="Switch off what you don't need at sign-in. Changes are reversible and match Task Manager: tasks are disabled, never deleted; services go to Manual, never Disabled." />
            <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource ScourCaption}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                <SelectorBarItem Text="Apps" Tag="RunKey" IsSelected="True" />
                <SelectorBarItem Text="Tasks" Tag="ScheduledTask" />
                <SelectorBarItem Text="Services" Tag="Service" />
            </SelectorBar>
            <AutoSuggestBox Grid.Column="2" PlaceholderText="Search" Width="220" QueryIcon="Find" VerticalAlignment="Center"
                            Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" OnContent="Microsoft items shown" OffContent="Microsoft items hidden" MinWidth="0"
                          IsOn="{x:Bind Vm.ShowMicrosoft, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />
            <ScrollViewer Margin="-36,0" Padding="36,0">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Rows}" Margin="0,0,0,36">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupRow">
                            <Border Style="{StaticResource ScourCard}" Padding="16,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource ScourBadge}" Background="{ThemeResource ScourAdvancedBackgroundBrush}" Visibility="{x:Bind h:Format.Show(IsBroken)}">
                                                <TextBlock Text="Broken" FontSize="11" Foreground="{ThemeResource ScourAdvancedBrush}" />
                                            </Border>
                                            <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Visibility="{x:Bind h:Format.Show(NeedsElevation)}" ToolTipService.ToolTip="Changing this needs admin" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ScourCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Command}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Publisher}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Publisher}" />
                                        <TextBlock Text="{x:Bind SignatureText}" Style="{StaticResource ScourCaption}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" OnContent="On" OffContent="Off"
                                                  MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
