<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Scour.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Scour.App.ViewModels"
    xmlns:h="using:Scour.App.Helpers">

    <Grid Padding="36,8,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with the running total and the actions. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Clean" Style="{StaticResource ScourPageTitle}" />
                <TextBlock Style="{StaticResource ScourSubtle}"
                           Text="Tick what to remove. Expand an item to see its largest files. Only what you see here is ever deleted." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{x:Bind Vm.ReclaimableText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Right"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="selected" Style="{StaticResource ScourCaption}" HorizontalAlignment="Right" />
                </StackPanel>
                <DropDownButton Content="Select">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Quick: safe caches, no admin" Tag="quick" Click="OnProfileClick" />
                            <MenuFlyoutItem Text="Deep: every safe item" Tag="deep" Click="OnProfileClick" />
                            <MenuFlyoutItem Text="Dev box: Quick plus package caches" Tag="dev" Click="OnProfileClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Defaults" Tag="defaults" Click="OnProfileClick" />
                            <MenuFlyoutItem Text="Nothing" Tag="none" Click="OnProfileClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="OnScanClick" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="OnCleanClick" IsEnabled="{x:Bind CanCleanNow(Vm.CanClean, Vm.IsBusy), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clean" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Format.Show(Vm.IsBusy), Mode=OneWay}" />
            <TextBlock Text="{x:Bind Vm.ScanStatus, Mode=OneWay}" Style="{StaticResource ScourCaption}"
                       Visibility="{x:Bind h:Format.Show(Vm.IsScanning), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar IsOpen="{x:Bind Vm.HasResult, Mode=OneWay}" Severity="Success" CloseButtonClick="OnResultClosed"
                     Title="{x:Bind Vm.ResultTitle, Mode=OneWay}" Message="{x:Bind Vm.ResultDetail, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Open the log" Click="OnOpenLogClick" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{x:Bind HasAdminWaiting(Vm.AdminRulesWaiting), Mode=OneWay}" Severity="Informational" IsClosable="False"
                     Title="Some items need admin access"
                     Message="Scour asks once, then a small helper scans and cleans just those system folders.">
                <InfoBar.ActionButton>
                    <Button Content="Allow" Click="OnUnlockClick" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Margin="-36,0,-36,0" Padding="36,0,36,0">
            <ItemsRepeater ItemsSource="{x:Bind Vm.Groups}" Margin="0,0,0,36">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="20" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryGroup">
                        <StackPanel Spacing="4">
                            <Grid Margin="4,0,4,4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind Rules}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleItem">
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="True">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="12" Padding="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{x:Bind Name}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Name}" />
                                                            <Border Style="{StaticResource ScourBadge}" Background="{ThemeResource ScourCautionBackgroundBrush}"
                                                                    Visibility="{x:Bind h:Format.Show(IsCaution)}">
                                                                <TextBlock Text="Caution" FontSize="11" Foreground="{ThemeResource ScourCautionBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource ScourBadge}" Background="{ThemeResource ScourAdvancedBackgroundBrush}"
                                                                    Visibility="{x:Bind h:Format.Show(IsAdvanced)}">
                                                                <TextBlock Text="Advanced" FontSize="11" Foreground="{ThemeResource ScourAdvancedBrush}" />
                                                            </Border>
                                                            <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                      Visibility="{x:Bind h:Format.Show(NeedsElevation)}" ToolTipService.ToolTip="Needs admin" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind h:Format.Show(IsRunning), Mode=OneWay}">
                                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource ScourCautionBrush}" />
                                                                <TextBlock Text="{x:Bind RunningText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ScourCautionBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource ScourCaption}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110">
                                                        <ProgressRing IsActive="{x:Bind IsScanning, Mode=OneWay}" Width="16" Height="16" HorizontalAlignment="Right"
                                                                      Visibility="{x:Bind h:Format.Show(IsScanning), Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ScourCaption}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>

                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Nothing found yet. Scan to see what this item would remove." Style="{StaticResource ScourCaption}"
                                                           Visibility="{x:Bind h:Format.Hide(HasFiles), Mode=OneWay}" />
                                                <ScrollViewer MaxHeight="360" Visibility="{x:Bind h:Format.Show(HasFiles), Mode=OneWay}">
                                                    <ItemsRepeater ItemsSource="{x:Bind Files}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FileRow">
                                                                <Grid ColumnSpacing="16" Padding="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind SizeText}" HorizontalAlignment="Right" Style="{StaticResource ScourCaption}" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Path}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                                <HyperlinkButton Content="{x:Bind MoreText, Mode=OneWay}" Command="{x:Bind ShowAllCommand}" Padding="0"
                                                                 Visibility="{x:Bind h:Format.Show(HasMore), Mode=OneWay}" />
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
