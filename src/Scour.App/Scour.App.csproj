<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Scour.App</RootNamespace>
    <AssemblyName>ScourApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\scour.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Generated XAML code is outside our control. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ScourCopyCli>true</ScourCopyCli>
  </PropertyGroup>

  <Import Project="..\..\build\Companions.targets" />

  <!-- Unpackaged publish leaves out the app's own resource index, and without it no XAML loads. -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
    <Error Text="$(AssemblyName).pri wasn't produced; the published app would fail to load its XAML." Condition="!Exists('$(PublishDir)$(AssemblyName).pri')" />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scour.Core\Scour.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\scour.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\scour.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules\**\*.json" Link="rules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
