<Project>
  <PropertyGroup>
    <!-- Windows 10 TFM gives Core the WinRT PackageManager for MSIX apps. 19041 is the floor;
         Scour is tested on Windows 10 22H2 (19045) and Windows 11. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <!-- LibraryImport (source-generated P/Invoke) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Scour contributors</Authors>
    <Product>Scour</Product>
    <Copyright>Copyright © Scour contributors</Copyright>
    <Version>1.0.0</Version>
    <!-- Where update checks look. Change if the repository moves. -->
    <ScourRepository>Mat2k/scour</ScourRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ScourRepository" Value="$(ScourRepository)" />
  </ItemGroup>
</Project>
