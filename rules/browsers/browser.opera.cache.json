    },
    {
      "path": "%LOCALAPPDATA%\\Opera Software\\Opera Stable\\GPUCache",
      "pattern": "*",
      "recurse": true
    },
    {
      "path": "%LOCALAPPDATA%\\Opera Software\\Opera Stable\\Service Worker\\CacheStorage",
      "pattern": "*",
      "recurse": true
    },
    {
      "path": "%LOCALAPPDATA%\\Opera Software\\Opera Stable\\DawnGraphiteCache",
      "pattern": "*",
      "recurse": true
    },
    {
      "path": "%LOCALAPPDATA%\\Opera Software\\Opera Stable\\DawnWebGPUCache",
      "pattern": "*",
      "recurse": true
    },
    {
      "path": "%LOCALAPPDATA%\\Opera Software\\Opera Stable\\ShaderCache",
