{
  "$schema": "../rule.schema.json",
  "id": "browser.chrome.history",
  "name": "Chrome history",
  "description": "Browsing history, visited-link colours and the new-tab shortcuts.",
  "category": "Browsers",
  "safety": "caution",
  "defaultEnabled": false,
  "elevation": false,
  "detect": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data"
  ],
  "runningProcesses": [
    "chrome.exe"
  ],
  "targets": [
    {
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\{chromiumProfile}",
      "pattern": "History*",
      "recurse": false
    },
    {
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\{chromiumProfile}",
      "pattern": "Visited Links",
      "recurse": false
    },
    {
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\{chromiumProfile}",
      "pattern": "Top Sites*",
      "recurse": false
    },
    {
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\{chromiumProfile}",
      "pattern": "Shortcuts*",
      "recurse": false
    }
  ],
  "exclude": [],
  "minAgeHours": 0
}
